# ~/.zprofile - sourced for LOGIN shells only
# One-time setup: ssh-agent, session vars, etc.

ZDOTDIR_DOTFILES="${${(%):-%x}:A:h}"

for f in "$ZDOTDIR_DOTFILES"/zprofile.d/<0-99>-*.zsh(N); do
  source "$f"
done

# Make mise tools available to programs launched from login sessions.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi

export __DOTFILES_PROFILE_SOURCED=1
