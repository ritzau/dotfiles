[pull]
	rebase = true
[core]
	autocrlf = input
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictStyle = zdiff3
[rebase]
	updateRefs = true
	autoStash = true
[fetch]
	prune = true
[diff]
	tool = kdiff3
[init]
	defaultBranch = main
[user]
	name = Tobias Ritzau
	email = tobias@ritzau.se
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

# Machine-local overrides (identity, signing, etc.).  Must stay last:
# later values win, so an include can only override what precedes it.
[include]
	path = ~/.gitconfig.local
